<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PresentationTimer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PresentationTimer.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <ToggleButton
                    x:Name="TitleBarPinButton"
                    x:Uid="TitleBarPinButton"
                    AutomationProperties.AutomationId="TitleBarPinButton"
                    IsChecked="{x:Bind PresenterPage.IsAlwaysOnTop, Mode=TwoWay}"
                    Style="{StaticResource PresenterTitleBarToggleStyle}">
                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE718;" />
                </ToggleButton>
            </TitleBar.RightHeader>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
