<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PresentationTimer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresentationTimer.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <SolidColorBrush x:Key="PresenterCompactSurfaceBrush" Color="#FF10141D" />
                    <StaticResource x:Key="PresenterTimerNormalBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="PresenterTimerWarningBrush" ResourceKey="SystemFillColorCautionBrush" />
                    <StaticResource x:Key="PresenterTimerOvertimeBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="PresenterDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
                    <StaticResource x:Key="PresenterCapabilitySurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="PresenterProgressTrackBrush" ResourceKey="ControlFillColorSecondaryBrush" />
                    <SolidColorBrush x:Key="PresenterCommandSurfaceBrush" Color="#E8E8E8" />
                    <Thickness x:Key="PresenterCardBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <SolidColorBrush x:Key="PresenterCompactSurfaceBrush" Color="#FF10141D" />
                    <StaticResource x:Key="PresenterTimerNormalBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="PresenterTimerWarningBrush" ResourceKey="SystemFillColorCautionBrush" />
                    <StaticResource x:Key="PresenterTimerOvertimeBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="PresenterDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
                    <StaticResource x:Key="PresenterCapabilitySurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="PresenterProgressTrackBrush" ResourceKey="ControlFillColorSecondaryBrush" />
                    <SolidColorBrush x:Key="PresenterCommandSurfaceBrush" Color="#2B2E34" />
                    <Thickness x:Key="PresenterCardBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterCompactSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PresenterTimerNormalBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterTimerWarningBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterTimerOvertimeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterCapabilitySurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PresenterProgressTrackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterCommandSurfaceBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                    <Thickness x:Key="PresenterCardBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PresenterCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource PresenterCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="PresenterCapabilityStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PresenterCapabilitySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PresenterCommandButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterPrimaryCommandButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterCompactIconButtonStyle" BasedOn="{StaticResource PresenterIconButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style x:Key="PresenterCompactPrimaryIconButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
            </Style>
            <Style x:Key="PresenterHeroActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="PresenterHeroPrimaryActionButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="28" />
            </Style>
            <Style x:Key="PresenterTitleBarToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterPresetButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
