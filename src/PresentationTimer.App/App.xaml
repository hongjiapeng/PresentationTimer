<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PresentationTimer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresentationTimer.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <SolidColorBrush x:Key="PresenterWindowSurfaceBrush" Color="#FFF4F7FB" />
                    <Color x:Key="PresenterHudBackdropTintColor">#FFF5F9FD</Color>
                    <x:Double x:Key="PresenterHudBackdropTintOpacity">0.55</x:Double>
                    <x:Double x:Key="PresenterHudBackdropLuminosityOpacity">0.24</x:Double>
                    <SolidColorBrush x:Key="PresenterHudSurfaceBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="PresenterHudHoverBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="PresenterHudBorderBrush" Color="#60FFFFFF" />
                    <SolidColorBrush x:Key="PresenterHudProgressTrackBrush" Color="#507B99BB" />
                    <SolidColorBrush x:Key="PresenterTimerNormalBrush" Color="#FF12528D" />
                    <SolidColorBrush x:Key="PresenterTimerWarningBrush" Color="#FFAD6B00" />
                    <SolidColorBrush x:Key="PresenterTimerOvertimeBrush" Color="#FFC63C45" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <SolidColorBrush x:Key="PresenterDividerBrush" Color="#FFD6DEE9" />
                    <SolidColorBrush x:Key="PresenterCapabilitySurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PresenterProgressTrackBrush" Color="#FFD5DFEC" />
                    <SolidColorBrush x:Key="PresenterCommandSurfaceBrush" Color="#FFE8EEF6" />
                    <Thickness x:Key="PresenterCardBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <SolidColorBrush x:Key="PresenterWindowSurfaceBrush" Color="#FF161B24" />
                    <Color x:Key="PresenterHudBackdropTintColor">#FF25334A</Color>
                    <x:Double x:Key="PresenterHudBackdropTintOpacity">0.80</x:Double>
                    <x:Double x:Key="PresenterHudBackdropLuminosityOpacity">0.72</x:Double>
                    <SolidColorBrush x:Key="PresenterHudSurfaceBrush" Color="#08283954" />
                    <SolidColorBrush x:Key="PresenterHudHoverBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="PresenterHudBorderBrush" Color="#48C0D4EC" />
                    <SolidColorBrush x:Key="PresenterHudProgressTrackBrush" Color="#509AB2D2" />
                    <SolidColorBrush x:Key="PresenterTimerNormalBrush" Color="#FFD8F0FF" />
                    <SolidColorBrush x:Key="PresenterTimerWarningBrush" Color="#FFFFC85A" />
                    <SolidColorBrush x:Key="PresenterTimerOvertimeBrush" Color="#FFFF777F" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <SolidColorBrush x:Key="PresenterDividerBrush" Color="#FF303947" />
                    <SolidColorBrush x:Key="PresenterCapabilitySurfaceBrush" Color="#FF1D232D" />
                    <SolidColorBrush x:Key="PresenterProgressTrackBrush" Color="#FF3B4553" />
                    <SolidColorBrush x:Key="PresenterCommandSurfaceBrush" Color="#2B2E34" />
                    <Thickness x:Key="PresenterCardBorderThickness">1</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PresenterEmphasisBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterWindowSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <Color x:Key="PresenterHudBackdropTintColor">#FF202020</Color>
                    <x:Double x:Key="PresenterHudBackdropTintOpacity">1</x:Double>
                    <x:Double x:Key="PresenterHudBackdropLuminosityOpacity">1</x:Double>
                    <StaticResource x:Key="PresenterHudSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PresenterHudHoverBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PresenterHudBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterHudProgressTrackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterTimerNormalBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterTimerWarningBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterTimerOvertimeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterSuccessBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterCapabilitySurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PresenterProgressTrackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PresenterCommandSurfaceBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                    <Thickness x:Key="PresenterCardBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="PresenterHudCornerRadius">16</CornerRadius>
            <x:Double x:Key="PresenterHudTimerFontSize">36</x:Double>
            <x:Double x:Key="PresenterHudRevealDurationMs">180</x:Double>
            <x:Double x:Key="PresenterHudHideDurationMs">180</x:Double>
            <x:Double x:Key="PresenterHudHideDelayMs">1250</x:Double>
            <Style x:Key="PresenterCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource PresenterCardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <Style x:Key="PresenterCapabilityStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PresenterCapabilitySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PresenterCommandButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterPrimaryCommandButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterHudActionButtonStyle" BasedOn="{StaticResource PresenterIconButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style x:Key="PresenterHudPrimaryButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>
            <Style x:Key="PresenterHeroActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="PresenterHeroPrimaryActionButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="28" />
            </Style>
            <Style x:Key="PresenterTitleBarToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PresenterCommandSurfaceBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="PresenterPresetButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
