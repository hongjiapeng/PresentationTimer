<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PresentationTimer.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PresentationTimer.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="PageTitle"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="PageSubtitle"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyLargeTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="AlwaysOnTopToggle"
                    AutomationProperties.AutomationId="AlwaysOnTopToggle"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    IsOn="{x:Bind IsAlwaysOnTop, Mode=TwoWay}"
                    TabIndex="0" />
            </Grid>

            <Border
                Grid.Row="1"
                MinHeight="320"
                Style="{StaticResource PresenterCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="CountdownModeLabel"
                            x:Load="{x:Bind ViewModel.IsCountdown, Mode=OneWay}"
                            AutomationProperties.AutomationId="CountdownModeLabel"
                            Text="{x:Bind ViewModel.TimerModeLabel, Mode=OneWay}"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="OvertimeModeLabel"
                            x:Load="{x:Bind ViewModel.IsOvertime, Mode=OneWay}"
                            AutomationProperties.AutomationId="OvertimeModeLabel"
                            Foreground="{ThemeResource PresenterEmphasisBrush}"
                            Text="{x:Bind ViewModel.TimerModeLabel, Mode=OneWay}"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TimerStatusText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.TimerStatusText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="CountdownDisplay"
                            x:Load="{x:Bind ViewModel.IsCountdown, Mode=OneWay}"
                            AutomationProperties.AutomationId="CountdownDisplay"
                            AutomationProperties.LiveSetting="Polite"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                            TextAlignment="Center"
                            Style="{StaticResource DisplayTextBlockStyle}" />
                        <TextBlock
                            x:Name="OvertimeDisplay"
                            x:Load="{x:Bind ViewModel.IsOvertime, Mode=OneWay}"
                            AutomationProperties.AutomationId="OvertimeDisplay"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource PresenterEmphasisBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                            TextAlignment="Center"
                            Style="{StaticResource DisplayTextBlockStyle}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="DurationInput"
                            AutomationProperties.AutomationId="DurationInput"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                            TabIndex="1"
                            Text="{x:Bind ViewModel.DurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Uid="StartButton"
                                AutomationProperties.AutomationId="StartButton"
                                Command="{x:Bind ViewModel.StartCommand, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="2">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button
                                x:Uid="PauseButton"
                                AutomationProperties.AutomationId="PauseButton"
                                Command="{x:Bind ViewModel.PauseCommand, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                                TabIndex="3">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="P" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button
                                x:Uid="ResumeButton"
                                AutomationProperties.AutomationId="ResumeButton"
                                Command="{x:Bind ViewModel.ResumeCommand, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}"
                                TabIndex="4" />
                            <Button
                                x:Uid="ResetButton"
                                AutomationProperties.AutomationId="ResetButton"
                                Command="{x:Bind ViewModel.ResetCommand, Mode=OneTime}"
                                TabIndex="5">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        x:Uid="ValidationInfoBar"
                        AutomationProperties.AutomationId="ValidationInfoBar"
                        Grid.Row="3"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsValidationOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                        Severity="Error" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PresenterCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE739;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                x:Uid="PowerPointCardTitle"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PowerPointStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.AutomationId="SlidePositionText"
                                Text="{x:Bind ViewModel.SlidePositionText, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="SpeakerNotesText"
                                AutomationProperties.AutomationId="SpeakerNotesText"
                                MaxHeight="72"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SpeakerNotes, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="PreviousSlideButton"
                                    AutomationProperties.AutomationId="PreviousSlideButton"
                                    Command="{x:Bind ViewModel.PreviousSlideCommand, Mode=OneTime}" />
                                <Button
                                    x:Uid="NextSlideButton"
                                    AutomationProperties.AutomationId="NextSlideButton"
                                    Command="{x:Bind ViewModel.NextSlideCommand, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PresenterCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource SystemFillColorNeutralBrush}"
                            Glyph="&#xE8EA;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                x:Uid="RemoteCardTitle"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                AutomationProperties.AutomationId="RemoteStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.RemoteStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.AutomationId="RemoteConnectionText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.RemoteConnectionText, Mode=OneWay}" />
                            <Grid
                                x:Name="PairingPanel"
                                x:Load="{x:Bind ViewModel.IsPairingVisible, Mode=OneWay}"
                                Margin="0,8,0,4"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    x:Uid="PairingQrImage"
                                    AutomationProperties.AutomationId="PairingQrImage"
                                    Height="112"
                                    Grid.RowSpan="2"
                                    Source="{x:Bind ViewModel.PairingQrImage, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Width="112" />
                                <ComboBox
                                    x:Name="PairingCandidateSelector"
                                    x:Uid="PairingCandidateSelector"
                                    x:Load="{x:Bind ViewModel.HasMultiplePairingCandidates, Mode=OneWay}"
                                    AutomationProperties.AutomationId="PairingCandidateSelector"
                                    Grid.Column="1"
                                    ItemsSource="{x:Bind ViewModel.PairingCandidateLabels, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedPairingCandidateIndex, Mode=TwoWay}" />
                                <TextBox
                                    x:Uid="PairingUrlText"
                                    AutomationProperties.AutomationId="PairingUrlText"
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.PairingUrl, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="StartRemoteButton"
                                    AutomationProperties.AutomationId="StartRemoteButton"
                                    Command="{x:Bind ViewModel.StartRemoteCommand, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Uid="EndRemoteButton"
                                    AutomationProperties.AutomationId="EndRemoteButton"
                                    Command="{x:Bind ViewModel.EndRemoteCommand, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <InfoBar
                x:Uid="TrustedNetworkInfoBar"
                Grid.Row="3"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning" />
        </Grid>
    </ScrollViewer>
</Page>
